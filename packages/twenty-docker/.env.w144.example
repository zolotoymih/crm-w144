# W144 production env template
# Copy to .env.w144 (gitignored) and fill in actual values
# OR set these directly in Coolify's environment variables UI

# === Public URLs (build-time + runtime) ===
SERVER_URL=https://crm.w144.com
FRONTEND_URL=https://crm.w144.com

# === Secrets (runtime only) ===
# Generate with: openssl rand -base64 32
APP_SECRET=

# === External database (Supabase project for Twenty, NOT main W144 project) ===
# Get from Supabase Dashboard > Project Settings > Database > Connection string
PG_DATABASE_URL=

# === External Redis (Coolify-managed) ===
# Get from Coolify after creating Redis resource
REDIS_URL=

# === Supabase SSO (main W144 project, for cross-domain auth) ===
SUPABASE_URL=https://qrbctwrzpcidzhzjkmnq.supabase.co
SUPABASE_JWT_ISSUER=https://qrbctwrzpcidzhzjkmnq.supabase.co/auth/v1
SUPABASE_JWKS_URI=https://qrbctwrzpcidzhzjkmnq.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_SERVICE_KEY=

# === Feature flags ===
IS_MULTIWORKSPACE_ENABLED=true
IS_WORKSPACE_CREATION_LIMITED_TO_SERVER_ADMINS=true
